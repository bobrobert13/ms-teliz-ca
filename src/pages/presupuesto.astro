---
import BaseLayout from '../layouts/BaseLayout.astro';
import PreHeader from '../components/layout/PreHeader.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppFloat from '../components/layout/WhatsAppFloat.astro';
import PreFooter from '../components/sections/PreFooter.astro';
---

<BaseLayout title="Presupuesto - Multiservicios Teliz">
  <PreHeader />
  <Header />

  <main class="py-8 bg-gray-50 min-h-screen" x-data>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-navy mb-8">Tu Presupuesto</h1>

      <!-- Empty State -->
      <div x-show="$store.budget.items.length === 0" class="text-center py-16">
        <div class="w-20 h-20 mx-auto mb-6 bg-gray-100 rounded-full flex items-center justify-center">
          <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
          </svg>
        </div>
        <h2 class="text-xl font-semibold text-navy mb-2">Tu presupuesto está vacío</h2>
        <p class="text-gray-500 mb-6">Agrega productos desde el catálogo para crear tu presupuesto.</p>
        <a href="/catalog" class="inline-flex items-center gap-2 px-6 py-3 bg-mustard text-navy font-bold rounded-full hover:bg-yellow-400 transition">
          Ver catálogo
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>

      <!-- Budget Items -->
      <div x-show="$store.budget.items.length > 0" class="space-y-4">
        <!-- Header -->
        <div class="hidden sm:grid grid-cols-12 gap-4 px-4 py-2 bg-navy text-white text-sm font-medium rounded-lg">
          <div class="col-span-6">Producto</div>
          <div class="col-span-2 text-center">Cantidad</div>
          <div class="col-span-2 text-right">Precio</div>
          <div class="col-span-2 text-right">Subtotal</div>
        </div>

        <!-- Items -->
        <template x-for="(item, index) in $store.budget.items" :key="item.id">
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 p-4 bg-white rounded-xl shadow-sm items-center">
            <div class="col-span-6 flex items-center gap-4">
              <img :src="item.image" :alt="item.name" class="w-16 h-16 rounded-lg object-cover bg-gray-100" />
              <div>
                <h3 class="font-semibold text-navy" x-text="item.name"></h3>
                <p class="text-sm text-gray-500" x-text="item.categoryLabel"></p>
              </div>
            </div>
            <div class="col-span-2 flex items-center justify-center gap-2">
              <button @click="item.quantity > 1 ? item.quantity-- : null" class="w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/></svg>
              </button>
              <span class="w-8 text-center font-semibold" x-text="item.quantity"></span>
              <button @click="item.quantity++" class="w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
              </button>
            </div>
            <div class="col-span-2 text-center sm:text-right">
              <span class="text-sm sm:hidden text-gray-500">Precio:</span>
              <span class="font-medium" x-text="'$' + item.price.toFixed(2)"></span>
            </div>
            <div class="col-span-2 flex items-center justify-between sm:text-right">
              <span class="font-semibold text-mustard" x-text="'$' + (item.price * item.quantity).toFixed(2)"></span>
              <button @click="$store.budget.remove(item.id)" class="w-8 h-8 rounded-full hover:bg-red-100 flex items-center justify-center text-red-500 transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              </button>
            </div>
          </div>
        </template>

        <!-- Totals -->
        <div class="mt-8 p-6 bg-white rounded-xl shadow-sm">
          <div class="flex justify-between items-center mb-4">
            <span class="text-gray-600">Subtotal</span>
            <span class="font-semibold text-navy" x-text="'$' + $store.budget.subtotal.toFixed(2)"></span>
          </div>
          <div class="border-t border-gray-200 pt-4 flex justify-between items-center">
            <span class="text-lg font-bold text-navy">Total</span>
            <span class="text-2xl font-extrabold text-mustard" x-text="'$' + $store.budget.total.toFixed(2)"></span>
          </div>
        </div>

        <!-- Actions -->
        <div class="flex flex-col sm:flex-row gap-4 mt-6">
          <button @click="$store.budget.clear()" class="flex-1 py-3 px-6 border-2 border-navy text-navy font-bold rounded-full hover:bg-navy/5 transition">
            Vaciar presupuesto
          </button>
          <button @click="sendToWhatsApp()" class="flex-1 py-3 px-6 bg-green-500 text-white font-bold rounded-full hover:bg-green-600 transition flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            Enviar por WhatsApp
          </button>
        </div>
      </div>
    </div>
  </main>

  <PreFooter />
  <Footer />
  <WhatsAppFloat />

  <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
  <script is:inline>
    function sendToWhatsApp() {
      const store = Alpine.store('budget');
      if (store.items.length === 0) {
        alert('Tu presupuesto está vacío');
        return;
      }

      let message = '🏪 *PRESUPUESTO - Multiservicios Teliz*\n\n';
      message += '📋 *Productos seleccionados:*\n\n';

      store.items.forEach((item, index) => {
        const subtotal = (item.price * item.quantity).toFixed(2);
        message += `${index + 1}. ${item.name}\n`;
        message += `   Cantidad: ${item.quantity} x $${item.price.toFixed(2)} = $${subtotal}\n\n`;
      });

      message += '━━━━━━━━━━━━━━━━━━━━\n';
      message += `💰 *TOTAL: $${store.total.toFixed(2)}*\n`;
      message += '━━━━━━━━━━━━━━━━━━━━\n\n';
      message += '📍 El Tigre, Anzoátegui\n';
      message += '📱 +58 412-8550056\n\n';
      message += '_Este presupuesto tiene validez de 24 horas_';

      const encoded = encodeURIComponent(message);
      window.open(`https://wa.me/584128550056?text=${encoded}`, '_blank');
    }
  </script>
</BaseLayout>
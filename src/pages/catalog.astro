---
import BaseLayout from '../layouts/BaseLayout.astro';
import PreHeader from '../components/layout/PreHeader.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppFloat from '../components/layout/WhatsAppFloat.astro';
import ProductCard from '../components/ui/ProductCard.astro';
import MapSection from '../components/sections/MapSection.astro';
import PreFooter from '../components/sections/PreFooter.astro';
import { products } from '../data/products';

const featuredProducts = products.slice(0, 8);
const categories = [
  { name: 'Limpieza', slug: 'limpieza', count: products.filter(p => p.cat === 'limpieza').length },
  { name: 'Oficina', slug: 'oficina', count: products.filter(p => p.cat === 'oficina').length },
  { name: 'Higiene', slug: 'higiene', count: products.filter(p => p.cat === 'higiene').length }
];
---

<BaseLayout title="Catálogo - Multiservicios Teliz">
  <PreHeader />
  <Header />

  <main>
    <!-- Hero -->
    <section class="bg-gradient-to-br from-navy to-navy/80 py-12 sm:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white mb-4">
          Catálogo de <span class="text-mustard">Productos</span>
        </h1>
        <p class="text-gray-300 text-lg max-w-2xl mx-auto">
          Todo lo que necesitas para limpieza, oficina e higiene. Calidad garantizada a precios competitivos.
        </p>
      </div>
    </section>

    <!-- Categories -->
    <section class="py-8 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-xl font-bold text-navy mb-6">Categorías</h2>
        <div class="grid grid-cols-3 gap-4 sm:gap-6">
          {categories.map(cat => (
            <a href={`/catalog?cat=${cat.slug}`} class="group p-6 bg-white rounded-xl shadow-sm hover:shadow-md transition text-center">
              <div class={`w-14 h-14 mx-auto rounded-xl flex items-center justify-center mb-4 ${
                cat.slug === 'limpieza' ? 'bg-mustard/10 text-mustard' :
                cat.slug === 'oficina' ? 'bg-navy/10 text-navy' :
                'bg-green-100 text-green-600'
              }`}>
                {cat.slug === 'limpieza' && (
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
                )}
                {cat.slug === 'oficina' && (
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                )}
                {cat.slug === 'higiene' && (
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
                )}
              </div>
              <h3 class="font-bold text-navy group-hover:text-mustard transition">{cat.name}</h3>
              <p class="text-sm text-gray-500 mt-1">{cat.count} productos</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Products Grid -->
    <section class="py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-8">
          <h2 class="text-xl font-bold text-navy">Todos los Productos</h2>
          <span class="text-gray-500 text-sm">{products.length} productos</span>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
          {featuredProducts.map(product => (
            <ProductCard
              id={product.id}
              name={product.name}
              price={product.price}
              image={product.image}
              categoryLabel={product.categoryLabel}
            />
          ))}
        </div>
      </div>
    </section>
  </main>

  <MapSection />
  <PreFooter />
  <Footer />
  <WhatsAppFloat />

  <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
</BaseLayout>
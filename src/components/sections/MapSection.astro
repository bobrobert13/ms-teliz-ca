---
import { LOCATION } from '../../config/constants';
---

<section class="py-8 sm:py-12 bg-navy/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h3 class="text-xl sm:text-2xl font-bold text-white text-center mb-6">Nuestra Ubicación</h3>
    <div class="w-full h-64 sm:h-80 lg:h-96 rounded-xl overflow-hidden shadow-xl">
      <iframe
        src={`https://www.google.com/maps?q=${LOCATION.coords}&z=${LOCATION.zoom}&hl=es&output=embed`}
        class="w-full h-full"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade">
      </iframe>
    </div>
    <p class="text-center text-gray-400 mt-4 text-sm sm:text-base">{LOCATION.text}</p>
  </div>
</section>
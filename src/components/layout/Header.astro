---
import { LOGO_URL, BUSINESS_NAME, TAGLINE, WHATSAPP_URL, PHONE } from '../../config/constants';
import SearchIcon from '../icons/Search.astro';
import ChevronDown from '../icons/ChevronDown.astro';
import ShoppingBag from '../icons/ShoppingBag.astro';
import WhatsAppIcon from '../icons/WhatsApp.astro';
---

<header class="bg-navy shadow-sm sticky top-0 z-50" x-data="{ productsOpen: false, mobileProductsOpen: false }">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3">
        <img src={LOGO_URL} alt={BUSINESS_NAME} class="h-10 sm:h-12 w-auto object-contain" />
        <div class="hidden sm:block">
          <span class="font-bold text-lg text-white">Multiservicios</span>
          <span class="font-bold text-lg text-mustard"> Teliz</span>
          <p class="text-xs text-gray-300 -mt-1">{TAGLINE}</p>
        </div>
      </a>

      <!-- Desktop Nav: Products Dropdown + Search -->
      <div class="hidden lg:flex items-center flex-1 gap-6">
        <!-- Products Dropdown -->
        <div class="relative ml-4" x-data="{ open: false }" @click.away="open = false" @scroll.window="open = false">
          <button @click="open = !open" class="flex items-center gap-2 px-3 md:px-4 py-2 bg-white/10 hover:bg-white/20 rounded-full text-white font-medium transition" :class="open ? 'bg-white/20' : ''">
            <span>Productos</span>
            <span :class="open ? 'rotate-180' : ''" class="transition-transform"><ChevronDown /></span>
          </button>

          <div x-show="open" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0" x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100 translate-y-0" x-transition:leave-end="opacity-0 translate-y-2" class="absolute top-full left-0 mt-2 w-[600px] bg-white rounded-2xl shadow-2xl overflow-hidden" @click="open = false">
            <div class="grid grid-cols-3 divide-x divide-gray-100">
              <!-- Limpieza -->
              <div class="p-5">
                <h3 class="font-bold text-navy mb-3 flex items-center gap-2">
                  <span class="w-8 h-8 bg-mustard/10 rounded-lg flex items-center justify-center text-mustard">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
                  </span>
                  Limpieza
                </h3>
                <ul class="space-y-2">
                  <li><a href="/catalog?cat=limpieza&sub=quimicos" class="text-slate hover:text-mustard text-sm block py-1">Químicos y Desinfectantes</a></li>
                  <li><a href="/catalog?cat=limpieza&sub=implementos" class="text-slate hover:text-mustard text-sm block py-1">Implementos de Aseo</a></li>
                  <li><a href="/catalog?cat=limpieza&sub=residuos" class="text-slate hover:text-mustard text-sm block py-1">Manejo de Residuos</a></li>
                  <li><a href="/catalog?cat=limpieza&sub=automotriz" class="text-slate hover:text-mustard text-sm block py-1">Cuidado Automotriz</a></li>
                </ul>
              </div>
              <!-- Oficina -->
              <div class="p-5">
                <h3 class="font-bold text-navy mb-3 flex items-center gap-2">
                  <span class="w-8 h-8 bg-navy/10 rounded-lg flex items-center justify-center text-navy">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                  </span>
                  Oficina
                </h3>
                <ul class="space-y-2">
                  <li><a href="/catalog?cat=oficina&sub=papel" class="text-slate hover:text-mustard text-sm block py-1">Papel y Cuadernos</a></li>
                  <li><a href="/catalog?cat=oficina&sub=escritura" class="text-slate hover:text-mustard text-sm block py-1">Escritura y Corrección</a></li>
                  <li><a href="/catalog?cat=oficina&sub=accesorios" class="text-slate hover:text-mustard text-sm block py-1">Accesorios de Escritorio</a></li>
                  <li><a href="/catalog?cat=oficina&sub=archivo" class="text-slate hover:text-mustard text-sm block py-1">Organización y Archivo</a></li>
                  <li><a href="/catalog?cat=oficina&sub=embalaje" class="text-slate hover:text-mustard text-sm block py-1">Embalaje y Cintas</a></li>
                </ul>
              </div>
              <!-- Higiene -->
              <div class="p-5">
                <h3 class="font-bold text-navy mb-3 flex items-center gap-2">
                  <span class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center text-green-600">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
                  </span>
                  Higiene
                </h3>
                <ul class="space-y-2">
                  <li><a href="/catalog?cat=higiene&sub=jabon" class="text-slate hover:text-mustard text-sm block py-1">Jabón Líquido</a></li>
                  <li><a href="/catalog?cat=higiene&sub=papel" class="text-slate hover:text-mustard text-sm block py-1">Papel Higiénico</a></li>
                  <li><a href="/catalog?cat=higiene&sub=toallas" class="text-slate hover:text-mustard text-sm block py-1">Toallas de Papel</a></li>
                  <li><a href="/catalog?cat=higiene&sub=dispensadores" class="text-slate hover:text-mustard text-sm block py-1">Dispensadores</a></li>
                </ul>
              </div>
            </div>
            <div class="bg-gray-50 px-5 py-3 flex items-center justify-between">
              <span class="text-sm text-slate">Ver todas las categorías</span>
              <a href="/catalog" class="text-mustard font-semibold text-sm hover:underline">Catálogo completo →</a>
            </div>
          </div>
        </div>

        <!-- Search -->
        <div class="flex-1 max-w-md">
          <div class="relative">
            <input type="text" placeholder="Buscar productos..." class="w-full pl-10 pr-4 py-2.5 bg-white/10 border border-white/20 rounded-full text-sm text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-mustard focus:border-transparent" />
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"><SearchIcon /></span>
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-1 sm:gap-2">
        <a href="/presupuesto" class="p-2 hover:bg-white/10 rounded-full transition relative" title="Presupuesto">
          <ShoppingBag />
          <span x-show="$store.budget.items.length > 0" x-text="$store.budget.items.length" class="absolute -top-1 -right-1 w-4 h-4 sm:w-5 sm:h-5 bg-mustard text-navy text-xs font-bold rounded-full flex items-center justify-center"></span>
        </a>
        <button class="p-2 hover:bg-white/10 rounded-full transition lg:hidden" @click="mobileProductsOpen = !mobileProductsOpen">
          <svg class="w-5 h-5 sm:w-6 sm:h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
        <a href={`${WHATSAPP_URL}${PHONE}`} target="_blank" class="hidden sm:flex p-2 hover:bg-white/10 rounded-full transition">
          <WhatsAppIcon />
        </a>
      </div>
    </div>
  </div>

  <!-- Mobile Products Menu -->
  <div x-show="mobileProductsOpen" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 max-h-0" x-transition:enter-end="opacity-100 max-h-[500px]" x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100 max-h-[500px]" x-transition:leave-end="opacity-0 max-h-0" class="lg:hidden overflow-hidden border-t border-white/10">
    <div class="px-4 py-4 space-y-2">
      <a href="/catalog?cat=limpieza" class="block py-2 px-3 rounded-lg text-white hover:bg-white/10">Limpieza</a>
      <a href="/catalog?cat=oficina" class="block py-2 px-3 rounded-lg text-white hover:bg-white/10">Oficina</a>
      <a href="/catalog?cat=higiene" class="block py-2 px-3 rounded-lg text-white hover:bg-white/10">Higiene</a>
      <a href="/presupuesto" class="block py-2 px-3 rounded-lg text-white hover:bg-white/10">Presupuesto</a>
    </div>
  </div>
</header>
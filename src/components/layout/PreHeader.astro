---
import { PHONE_FORMATTED, SCHEDULE, WHATSAPP_URL, PHONE } from '../../config/constants';
import WhatsAppIcon from '../icons/WhatsApp.astro';
import ClockIcon from '../icons/Clock.astro';
---

<div class="bg-slate text-white text-xs sm:text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-1.5 sm:py-2">
    <div class="flex items-center justify-between gap-4">
      <div class="hidden sm:block"></div>
      <div class="flex items-center gap-3 sm:gap-6">
        <div class="hidden md:flex items-center gap-2">
          <ClockIcon />
          <span class="text-gray-300">{SCHEDULE.days}:</span>
          <span class="font-medium">{SCHEDULE.hours}</span>
        </div>
        <div class="hidden sm:block text-gray-600">|</div>
        <div class="flex md:hidden items-center gap-2">
          <ClockIcon />
          <span class="font-medium">8AM-12AM</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-green-400"><WhatsAppIcon /></span>
          <a href={`${WHATSAPP_URL}${PHONE}`} target="_blank" class="font-medium hover:text-green-400 transition">{PHONE_FORMATTED}</a>
        </div>
      </div>
    </div>
  </div>
</div>